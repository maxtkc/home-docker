              "expr": "label_replace(sum by (namespace, workload) (rate(container_fs_writes_bytes_total{namespace=~\"$namespace\", container!=\"\"}[$__rate_interval]) * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{workload_type!~\"(?i)(cron)?job\"}), \"workload\", \"$1\", \"workload\", \"(?:alertmanager-|prometheus-)?kube-prometheus-stack-(.*)\")",
              "legendFormat": "{{workload}} write",
              "refId": "B",
              "format": "time_series"
            }
          ]
        }
      ]
    }
  ]
}
