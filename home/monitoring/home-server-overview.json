    {
      "id": 15,
      "type": "stat",
      "title": "Workloads",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of ready pods per Deployment, StatefulSet, DaemonSet or CNPG cluster. Green: all ready, red: none.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "valueSize": 13
        },
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(label_replace(avg by (namespace, workload) (max by (namespace, pod) (kube_pod_status_ready{namespace=~\"$namespace\", condition=\"true\"}) * on (namespace, pod) group_left (workload) namespace_workload_pod:kube_pod_owner:relabel{workload_type!~\"(?i)(cron)?job\"}), \"workload\", \"$1\", \"workload\", \"(?:alertmanager-|prometheus-)?kube-prometheus-stack-(.*)\"))",
          "legendFormat": "{{workload}}",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Needs attention",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Pods not ready, containers restarted in the selected range, failed Jobs.",
      "gridPos": {
